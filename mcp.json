{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "picsart": {
      "type": "streamable-http",
      "url": "https://mcp.picsart.io/v1",
      "headers": {
        "X-Picsart-API-Key": "${PICSART_API_KEY}",
        "Accept": "application/json"
      }
    },
    "picsart-gen-ai": {
      "type": "streamable-http",
      "url": "https://api.picsart.com/gen-ai/mcp"
    }
  }
}
